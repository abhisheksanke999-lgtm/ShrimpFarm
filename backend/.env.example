# Neon PostgreSQL connection string
# Dashboard → your project → Connection string → copy URI
DATABASE_URL=postgresql://neondb_owner:npg_ifFDhpaU70Xy@ep-summer-lake-azw67k8n-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Secret used to sign login cookies (change this!)
SECRET_KEY=change-me-to-a-long-random-string

# Cookie settings
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_SECURE=true

# Email — Render blocks Gmail SMTP (ports 587/465 → Network unreachable).
# Use Brevo HTTPS (free): https://app.brevo.com → SMTP & API → API keys
BREVO_API_KEY=
# Optional alternative: https://resend.com/api-keys
RESEND_API_KEY=

# Gmail SMTP (local uvicorn only; ignored/blocked on Render)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=AquaControl
ALLOW_CONSOLE_OTP=false
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# Neon PostgreSQL connection string
# Dashboard → your project → Connection string → copy URI
DATABASE_URL=postgresql://neondb_owner:npg_ifFDhpaU70Xy@ep-summer-lake-azw67k8n-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Secret used to sign login cookies (change this!)
SECRET_KEY=change-me-to-a-long-random-string

# Cookie settings
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_SECURE=true

# Gmail SMTP for OTP emails (REQUIRED on the machine that runs the API).
# If the frontend calls https://acqacontrol.onrender.com, set these in Render → Environment.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=AquaControl
# Local-only: print OTP in server logs instead of emailing (never enable on Render)
ALLOW_CONSOLE_OTP=false
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
